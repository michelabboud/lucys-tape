cmd_stats() {
    [ -f "$DB" ] || die "no archive DB — run: tape update"
    python3 - "$DB" "$ARCHIVE" <<'PY'
import sqlite3, sys, os, collections
db, arch = sys.argv[1], sys.argv[2]
c = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
n, = c.execute("SELECT COUNT(*) FROM conversations").fetchone()
dlg, stp = c.execute("SELECT COALESCE(SUM(n_dialogue),0),COALESCE(SUM(n_steps),0) FROM conversations").fetchone()
lo, hi = c.execute("SELECT MIN(started),MAX(started) FROM conversations").fetchone()
B="\033[1m"; X="\033[0m"; G="\033[36m"
print(f"{B}📼 Lucy's Tape — archive statistics{X}")
print(f"  conversations : {B}{n}{X}")
print(f"  dialogue turns: {dlg:,}   tool steps: {stp:,}")
print(f"  span          : {(lo or '?')[:10]} → {(hi or '?')[:10]}")
print(f"\n{B}By project (top 10){X}")
for proj, k, t in c.execute("SELECT project,COUNT(*),SUM(n_dialogue) FROM conversations GROUP BY project ORDER BY 2 DESC LIMIT 10"):
    print(f"  {k:5d}  {proj}  {G}({t:,} turns){X}")
print(f"\n{B}By model{X}")
mc = collections.Counter()
for (m,) in c.execute("SELECT models FROM conversations"):
    for x in [s.strip() for s in (m or '').split(',') if s.strip()]:
        mc[x]+=1
for m,k in mc.most_common():
    print(f"  {k:5d}  {m}")
rep = os.path.join(arch, "REDACTION-REPORT.txt")
if os.path.exists(rep):
    first = open(rep).readline().strip()
    print(f"\n{B}Secrets{X}\n  {first}")
PY
}

