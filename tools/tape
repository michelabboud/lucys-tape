# ---- preflight (shared) ------------------------------------------------------
preflight() {
    [ -d "$HOME/.claude/projects" ] || die "source dir ~/.claude/projects is missing — is Claude Code in use on this machine?"
    [ -d "$REPO/.git" ]             || die "repo not found at $REPO"
    command -v python3 >/dev/null   || die "python3 not on PATH"
    local f; f="$(free_gb_of "$ARCHIVE")"
    [ -n "$f" ] || die "could not read free disk space"
    [ "$f" -ge "$MIN_FREE_GB" ] || die "low disk: ${f}GB free < ${MIN_FREE_GB}GB — refusing to run"
    echo "$f"
}

# Build and record the archive commit on a private index. Sets COMMITTED=1 when a
# commit was made and BRANCH to the branch it went on. Returns non-zero on any failure,
# leaving HEAD, the user's index and the working tree as they were.
commit_archive() {
    COMMITTED=0
    BRANCH="$(git symbolic-ref --quiet --short HEAD)" || { bad "HEAD is detached — check out your archive branch first"; log "archive commit: detached HEAD"; return 1; }
    local parent idx tree commit gate problems skipped changes
    parent="$(git rev-parse --verify --quiet HEAD)" || parent=""
    idx="$(mktemp "${TMPDIR:-/tmp}/lucys-tape-index.XXXXXX")" || { bad "cannot create a temporary index"; return 1; }
    TMP_INDEX="$idx"  # removed by the EXIT trap if we are killed mid-way
    if [ -n "$parent" ]; then GIT_INDEX_FILE="$idx" git read-tree "$parent" 2>>"$LOG"
    else GIT_INDEX_FILE="$idx" git read-tree --empty 2>>"$LOG"; fi \
        && GIT_INDEX_FILE="$idx" git add -A -- archive/ 2>>"$LOG" \
        && gate="$(GIT_INDEX_FILE="$idx" archive_gate)" \
        || { rm -f "$idx"; bad "could not stage the archive — nothing committed (see: tape logs)"; log "archive commit: staging failed"; return 1; }
    read -r problems skipped changes <<<"$gate"
    [ "${skipped:-0}" -gt 0 ] && warn "${skipped} file(s) under archive/ are not archive output and were left uncommitted (see: tape logs)"
    if [ "${problems:-1}" != "0" ]; then
        rm -f "$idx"; bad "archive check: ${problems} problem(s) — nothing committed (see: tape logs)"
        log "archive commit: ${problems} problem(s), nothing committed"; return 1
    fi
    if [ "${changes:-0}" = "0" ]; then rm -f "$idx"; ok "no changes to commit"; return 0; fi
    tree="$(GIT_INDEX_FILE="$idx" git write-tree 2>>"$LOG")"; rm -f "$idx"
    [ -n "$tree" ] || { bad "git write-tree failed — nothing committed"; return 1; }
    commit="$(git commit-tree "$tree" ${parent:+-p "$parent"} -m "chore: refresh archive ($(date -u +%Y-%m-%dT%H:%MZ))" 2>>"$LOG")" \
        && [ -n "$commit" ] || { bad "git commit-tree failed — nothing committed"; return 1; }
    # compare-and-swap: refuses if the branch moved while we worked
    # (an empty old value means "must not exist yet", for a first commit)
    git update-ref -m "tape: refresh archive" "refs/heads/$BRANCH" "$commit" "$parent" 2>>"$LOG" \
        || { bad "the branch moved during the refresh — nothing committed, run again"; log "archive commit: update-ref refused"; return 1; }
    # the user's index still lists the old blobs of the files just committed; point
    # those entries (only those) at the new commit so `git status` stays clean
    git diff-tree -r -z --no-renames --name-only ${parent:+"$parent"} "$commit" 2>>"$LOG" \
        | GIT_LITERAL_PATHSPECS=1 git reset -q --pathspec-from-file=- --pathspec-file-nul 2>>"$LOG" \
        || warn "could not refresh the index for the committed files (run: git reset -- archive/)"
    COMMITTED=1; ok "committed ${changes} archive change(s)"
}

# Mask residual secrets in every file the archive publishes (Markdown, INDEX.md, the
# redaction report), then verify nothing matching the guard is left. Everything that
# reads the Markdown (the commit, the DB, backups, releases) runs after this.
mask_and_verify() {
    say "leak guard: masking any residual secrets the redactor missed…"
    local mask_out mf mh
    mask_out="$(mask_leaks)" || { bad "leak-mask pass crashed — output unverified"; return 1; }
    read -r mf mh <<<"$mask_out"
    if [ "${mh:-0}" -gt 0 ]; then
        warn "guard masked ${mh} residual secret(s) across ${mf} file(s) — harden the redactor at source (see: tape logs)"
        log "guard-mask: ${mh} residual secret(s) masked across ${mf} file(s)"
    else
        ok "leak guard: output already clean (0 residual)"
    fi
    # backstop: if anything STILL matches after masking, masking itself is broken → fail-closed.
    if LC_ALL=C grep -rlqE --include='*.md' --include='REDACTION-REPORT.txt' "$LEAK_RX" "$ARCHIVE" 2>/dev/null; then
        bad "leak guard: pattern STILL present after masking (investigate the masker)"; return 1
    fi
    ok "leak guard passed (output verified clean)"
}

# ============================================================================
cmd_update() {
    mkdir -p "$ARCHIVE" 2>/dev/null  # the lock logs into it
    local lk=0; acquire_lock || lk=$?
    [ "$lk" -eq 2 ] && die "refresh lock is not ours — nothing was done"
    [ "$lk" -ne 0 ] && { say "another refresh is already running — exiting"; exit 0; }

    mkdir -p "$ARCHIVE" || die "cannot create $ARCHIVE"
    # existing installs made before 0.2.17 may be readable by others: take group and
    # other access off the repo folder (which blocks the way in) and everything in archive/
    chmod go-rwx "$REPO" "$ARCHIVE" 2>>"$LOG" && chmod -R go-rwx "$ARCHIVE" 2>>"$LOG" \
        || warn "could not make the archive private (check its ownership)"
    # leftovers of an interrupted DB build: our own side files, always regenerable
    rm -f "$DB.next" "$DB".next.tmp-* "$DB".tmp-* "$DB".next-journal 2>/dev/null
    # preflight runs in a subshell to capture its output, so its `die` only ends that
    # subshell: the status must be checked here, or a refusal (low disk) is ignored.
    local free_gb; free_gb="$(preflight)" || { echo "$free_gb"; exit 1; }
    say "refresh starting (${free_gb}GB free)"; log "refresh starting (${free_gb}GB free)"
    cd "$REPO" || die "cannot cd to repo"

    # Ratchet: remember the archive size BEFORE this refresh. A rebuilt archive
    # that shrinks below half the previous count means the extractor (or the
    # sources) broke — never commit a mass-vanishing over a good archive.
    local prev_count; prev_count="$(db_count)"

    # 1. sources -> Markdown (the committed source of truth)
    say "extracting (read-only on sources)…"
    python3 "$EXTRACT" "$ARCHIVE" >>"$LOG" 2>&1 || die "extractor failed (see: tape logs)"
    mask_and_verify || die "leak guard failed — refusing to commit (see: tape logs)"

    # 2. verified Markdown -> DB (a local build artifact, git-ignored). Built only now,
    # from the masked and verified Markdown (LT-SEC-001: built before masking, the DB,
    # backups and release snapshots kept what the guard masked), into a NEW file that
    # replaces the old one only after it passes the sanity checks, so a failed or
    # suspicious rebuild leaves the last good DB in place (LT-SEC-015).
    local next="$DB.next"
    python3 "$BUILD" "$ARCHIVE" "$next" >>"$LOG" 2>&1 || { rm -f "$next"; die "DB build failed (see: tape logs)"; }
    local count; count="$(db_count "$next")"
    if [ "${count:-0}" -lt "$SANITY_MIN" ]; then
        rm -f "$next"; die "only ${count} conversations (< ${SANITY_MIN}) — looks broken; NOT committing (previous DB kept)"
    fi
    if [ "${prev_count:-0}" -gt 10 ] && [ "$count" -lt $((prev_count / 2)) ]; then
        rm -f "$next"; die "archive shrank ${prev_count} → ${count} (more than half) — looks broken; NOT committing (previous DB kept)"
    fi
    mv -f "$next" "$DB" || die "could not replace the DB"
    ok "extracted + built ${count} conversations"; log "built ${count}"

    # 3. commit ONLY the archive's own output (LT-SEC-003). The commit is built in a
    # private index and written with commit-tree + update-ref: the user's staging area
    # is never read or swept in, no commit hook can add files, and nothing staged
    # meanwhile can ride along. The DB is git-ignored and never committed.
    local rc=0
    commit_archive || rc=1
    if [ "$rc" -eq 0 ] && [ "$COMMITTED" = "1" ]; then
        local why
        if ! why="$(check_destination)"; then
            warn "not pushed (commit kept locally): $why"; log "push refused: $why"; rc=1
        elif git push -q origin "refs/heads/$BRANCH:refs/heads/$BRANCH" 2>>"$LOG"; then ok "pushed Markdown diffs"
        else warn "git push failed (local commit preserved) — check your remote: tape doctor"; rc=1; fi
    fi

    # 4. weekly (Sundays): durable backup + compressed-DB GitHub release snapshot
    local weekly=0
    [ "$(date +%u)" -eq 7 ] && weekly=1
    [ "$FORCE_DB_DAILY" = "1" ] && weekly=1
    if [ "$weekly" -eq 1 ] && [ "$rc" -ne 0 ]; then
        warn "skipped the weekly backup and release: this refresh did not commit cleanly"; log "weekly skipped (rc=$rc)"
    elif [ "$weekly" -eq 1 ]; then
        _do_backup || rc=1
        _publish_db_snapshot || rc=1
    fi
    log "refresh complete (rc=$rc)"
    [ "$rc" -eq 0 ] && say "${G}done${X}" || say "${Y}done with warnings (rc=$rc) — see: tape logs${X}"
    return "$rc"
}

cmd_build() {
    [ -d "$ARCHIVE/conversations" ] || die "no Markdown to build from — run: tape update"
    mask_and_verify || die "leak guard failed — not building (see: tape logs)"
    say "building DB from Markdown…"
    python3 "$BUILD" "$ARCHIVE" || die "build failed"
    ok "DB ready ($(db_count) conversations) → tape serve"
}

# compressed DB as a GitHub Release asset (outside git history — no bloat, no LFS)
_publish_db_snapshot() {
    command -v gh >/dev/null || { warn "gh CLI not found — skipped DB release snapshot (optional)"; return 0; }
    gh auth status >/dev/null 2>&1 || { warn "gh not authenticated — skipped DB release snapshot"; return 0; }
    # A release is published only on the trusted destination, and only once GitHub
    # itself confirms that repo is PRIVATE. Every gh call names the repo: left to
    # itself, gh can resolve the public upstream this clone came from (LT-SEC-004).
    local why slug vis
    why="$(check_destination)" || { warn "skipped DB release snapshot: $why"; log "release refused: $why"; return 1; }
    slug="$(github_slug "$(trusted_dest)")"
    [ -n "$slug" ] && [ "$slug" != "INVALID" ] || { warn "skipped DB release snapshot: the trusted destination is not a GitHub repo"; return 0; }
    vis="$(github_visibility "$slug")"
    [ "$vis" = "PRIVATE" ] || { warn "skipped DB release snapshot: GitHub does not confirm $slug is PRIVATE (got: ${vis:-no answer})"; log "release refused: visibility ${vis:-unknown}"; return 1; }
    local tag="snapshot-$(date +%Y-%m-%d)" gz="$ARCHIVE/conversations.db.gz"
    gzip -c "$DB" > "$gz" 2>>"$LOG" || { warn "gzip of DB failed"; return 1; }
    if gh release view "$tag" --repo "github.com/$slug" >/dev/null 2>&1; then
        gh release upload "$tag" "$gz" --repo "github.com/$slug" --clobber >>"$LOG" 2>&1 && ok "DB snapshot updated on release $tag" || { warn "DB asset upload failed"; rm -f "$gz"; return 1; }
    else
        gh release create "$tag" "$gz" --repo "github.com/$slug" --title "Archive snapshot $tag" \
            --notes "Compressed SQLite DB ($(du -h "$gz" | cut -f1)). Rebuildable anytime with \`tape build\`." >>"$LOG" 2>&1 \
            && ok "published DB snapshot release $tag" || { warn "release create failed"; rm -f "$gz"; return 1; }
    fi
    rm -f "$gz"
}

# Keep the newest $KEEP_BACKUPS backups (LT-SEC-012: parsing `ls` let a planted file
# name become an argument to rm). Only regular files you own whose name is exactly
# lucys-tape-archive-YYYY-MM-DD.tar.gz are candidates; each is removed by exact path.
rotate_backups() { python3 - "$BACKUP_DIR" "$KEEP_BACKUPS" "$LOG" <<'PY'
import os, re, stat, sys
d, keep, logpath = sys.argv[1], int(sys.argv[2]), sys.argv[3]
name_rx = re.compile(r"lucys-tape-archive-\d{4}-\d{2}-\d{2}\.tar\.gz")
mine = []
with os.scandir(d) as it:
    for e in it:
        if not name_rx.fullmatch(e.name):
            continue
        st = e.stat(follow_symlinks=False)
        if stat.S_ISREG(st.st_mode) and st.st_uid == os.getuid():
            mine.append((e.name, e.path))  # the date is in the name: sort by it
failed = 0
ordered = sorted(mine, reverse=True)
for _name, path in ordered[:max(keep, 1)]:
    os.chmod(path, 0o600)  # backups made before 0.2.17 were readable by others
with open(logpath, "a", encoding="utf-8") as lg:
    for name, path in ordered[max(keep, 1):]:
        try:
            os.unlink(path)
            lg.write(f"  backup rotation: removed {name}\n")
        except OSError as err:
            failed += 1
            lg.write(f"  backup rotation: could not remove {name}: {err.strerror}\n")
sys.exit(1 if failed else 0)
PY
}

_do_backup() {
    [ -n "$BACKUP_DIR" ] || { warn "TAPE_BACKUP_DIR unset — skipped durable backup (set it to a second disk/cloud-synced folder)"; return 0; }
    [ -d "$ARCHIVE/conversations" ] || { warn "no archive yet to back up — run: tape update"; return 1; }
    mkdir -p "$BACKUP_DIR" || { warn "cannot create $BACKUP_DIR"; return 1; }
    mask_and_verify || { warn "leak guard failed — no backup made"; return 1; }
    local stamp; stamp="$(date +%Y-%m-%d)"
    if tar -czf "$BACKUP_DIR/lucys-tape-archive-${stamp}.tar.gz" -C "$REPO" archive tools README.md 2>>"$LOG"; then
        ok "backup: lucys-tape-archive-${stamp}.tar.gz → $BACKUP_DIR"
        rotate_backups || { warn "backup made, but rotating old backups failed (see: tape logs)"; return 1; }
        return 0
    fi
    warn "backup tarball failed"; return 1
}

cmd_backup() { say "forcing durable backup…"; _do_backup; }

