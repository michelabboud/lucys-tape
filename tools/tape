#!/usr/bin/env bash
# ╭──────────────────────────────────────────────────────────────────────────╮
# │  tape — control CLI for Lucy's Tape, your conversation archive           │
# │  init · update · build · serve · stop · install · uninstall · status     │
# │  · stats · backup · logs · doctor · help                                 │
# │  Linux/WSL (systemd timer) + macOS (launchd). Python tools run anywhere. │
# ╰──────────────────────────────────────────────────────────────────────────╯
set -uo pipefail

# ---- resolve paths -----------------------------------------------------------
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"
ARCHIVE="$REPO/archive"
DB="$ARCHIVE/conversations.db"
LOG="$ARCHIVE/refresh.log"
LOCKDIR="${TMPDIR:-/tmp}/lucys-tape-refresh.lock.d"
VIEWER="$REPO/tools/conversations_viewer.py"
EXTRACT="$REPO/tools/extract_conversations.py"
BUILD="$REPO/tools/build_db.py"
UNIT_DIR="$HOME/.config/systemd/user"
LAUNCHD_DIR="$HOME/Library/LaunchAgents"
LAUNCHD_LABEL="com.lucys-tape.refresh"
PORT="${TAPE_PORT:-8124}"
OS="$(uname -s)"

# ---- tunables (override via env) --------------------------------------------
MIN_FREE_GB="${TAPE_MIN_FREE_GB:-2}"
KEEP_BACKUPS="${TAPE_KEEP_BACKUPS:-8}"
# Sanity floor: refuse to commit if the rebuilt archive holds fewer than this
# many conversations. Low by default (new users start near zero); the RATCHET
# below is the real protection once an archive has history.
SANITY_MIN="${TAPE_SANITY_MIN:-1}"
FORCE_DB_DAILY="${TAPE_FORCE_DB_DAILY:-0}"
BACKUP_DIR="${TAPE_BACKUP_DIR:-}"
LEAK_RX='sk-ant-[A-Za-z0-9]{15}|\bsk-[A-Za-z0-9]{20}|xai-[A-Za-z0-9]{20}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|[0-9]{8,}:[A-Za-z0-9_-]{35}|\b(MII[A-Za-z0-9+/]{3}IBAAK[BC]|MII[A-Za-z0-9+/]{3}IBADANBgkqhkiG9w0BAQEFAASC|MHcCAQEE|MIGkAgEBBD|MIHcAgEBBE|MIGHAgEAMBMGByqGSM49|MIG2AgEAMBAGByqGSM49|MIHuAgEAMBAGByqGSM49|MC4CAQAwBQYDK2V[uw]|MEcCAQAwBQYDK2Vx|MEYCAQAwBQYDK2Vv|b3BlbnNzaC1rZXktdjE)|\bsk-[a-z]{2,12}-[A-Za-z0-9_-]{20}'

# ---- pretty output -----------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    B=$'\e[1m'; D=$'\e[2m'; R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; M=$'\e[35m'; X=$'\e[0m'
else
    B=''; D=''; R=''; G=''; Y=''; C=''; M=''; X=''
fi
say()  { echo "${C}📼${X} $*"; }
ok()   { echo "  ${G}✓${X} $*"; }
warn() { echo "  ${Y}!${X} $*"; }
bad()  { echo "  ${R}✗${X} $*"; }
log()  { echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*" >>"$LOG"; }
die()  { bad "$*"; log "FATAL: $*"; exit 1; }

# Portable free-GB (GNU df's --output is Linux-only; shutil works everywhere).
free_gb_of() { python3 -c 'import shutil,sys;print(shutil.disk_usage(sys.argv[1]).free // 2**30)' "$1" 2>/dev/null; }
db_count()   { python3 - "$DB" <<'PY' 2>/dev/null
import sqlite3, sys
try: print(sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True).execute("SELECT COUNT(*) FROM conversations").fetchone()[0])
except Exception: print(0)
PY
}

# Portable single-instance lock: mkdir is atomic on every POSIX filesystem
# (flock does not exist on macOS). Stale locks (dead pid) are reclaimed.
acquire_lock() {
    if mkdir "$LOCKDIR" 2>/dev/null; then
        echo $$ >"$LOCKDIR/pid"
        trap 'rm -rf "$LOCKDIR"' EXIT
        return 0
    fi
    local pid; pid="$(cat "$LOCKDIR/pid" 2>/dev/null)"
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
        rm -rf "$LOCKDIR" && acquire_lock && return 0
    fi
    return 1
}

# Leak guard, masking edition. The redactor is the primary filter; this is the
# last-line net for anything it missed. Instead of ABORTING the whole refresh (a
# stuck pipeline protects nobody, and the unmasked secret sits in the tree anyway),
# we MASK every residual LEAK_RX hit in place — over-redaction beats any leak — and
# let the commit proceed. Each affected file + hit-count is logged (never the value),
# so the redactor can still be hardened at source. Prints "<files> <hits>".
mask_leaks() { python3 - "$ARCHIVE/conversations" "$LEAK_RX" "$LOG" <<'PY'
import os, re, sys
root, rx_src, logpath = sys.argv[1], sys.argv[2], sys.argv[3]
rx = re.compile(rx_src, re.ASCII)  # same \b as grep in the C locale and the redactor
MARK = "[****REDACTED-BY-GUARD****]"  # asterisked; matches no LEAK_RX (idempotent); greppable for audit
files = hits = 0
with open(logpath, "a", encoding="utf-8") as lg:
    for dp, _, fns in os.walk(root):
        for fn in fns:
            if not fn.endswith(".md"):
                continue
            p = os.path.join(dp, fn)
            try:
                txt = open(p, encoding="utf-8").read()
            except Exception as e:
                lg.write(f"  guard-mask: WARN unreadable {os.path.relpath(p, root)}: {type(e).__name__}\n")
                continue
            new, n = rx.subn(MARK, txt)
            if n:
                open(p, "w", encoding="utf-8").write(new)
                files += 1; hits += n
                lg.write(f"  guard-mask: masked {n} residual secret(s) in {os.path.relpath(p, root)}\n")
print(f"{files} {hits}")
PY
}

