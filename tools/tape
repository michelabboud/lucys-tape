${B}USAGE${X}
  tape <command>

${B}COMMANDS${X}
  ${C}init${X}        One-time setup wizard: your private remote, first extraction,
              the daily timer, and a 'tape' command on your PATH
  ${C}update${X}      Refresh now: extract Markdown → build DB → guard → commit & push
              (commits diffable Markdown only; Sundays also: durable backup + a
              compressed-DB GitHub Release snapshot when configured)
  ${C}build${X}       Rebuild the searchable DB from the committed Markdown (works on
              any clone, no ~/.claude needed)
  ${C}backup${X}      Force a durable .tar.gz backup to \$TAPE_BACKUP_DIR now
  ${C}serve${X}       Start the web viewer at http://127.0.0.1:${PORT}
  ${C}stop${X}        Stop the web viewer
  ${C}install${X}     Install + enable the daily timer (systemd on Linux/WSL,
              launchd on macOS)
  ${C}uninstall${X}   Disable + remove the timer
