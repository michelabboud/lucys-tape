cmd="${1:-help}"; shift || true
case "$cmd" in
    init|setup)      cmd_init "$@" ;;
    update|refresh)  cmd_update "$@" ;;
    build)           cmd_build "$@" ;;
    backup)          cmd_backup "$@" ;;
    serve|view)      cmd_serve "$@" ;;
    stop)            cmd_stop "$@" ;;
    install)         cmd_install "$@" ;;
    uninstall)       cmd_uninstall "$@" ;;
    status|monitor)  cmd_status "$@" ;;
    stats)           cmd_stats "$@" ;;
    logs|log)        cmd_logs "$@" ;;
    doctor|check)    cmd_doctor "$@" ;;
    trust)           cmd_trust "$@" ;;
    help|-h|--help)  cmd_help ;;
    *) bad "unknown command: $cmd"; echo; cmd_help; exit 2 ;;
esac
