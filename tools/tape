cmd_doctor() {
    say "${B}preflight checks${X}"
    [ -d "$HOME/.claude/projects" ] && ok "sources: ~/.claude/projects present" || bad "sources missing (is Claude Code in use here?)"
    [ -d "$REPO/.git" ] && ok "repo: $REPO" || bad "repo missing"
    command -v python3 >/dev/null && ok "python3: $(python3 --version 2>&1)" || bad "python3 missing"
    command -v git >/dev/null && ok "git: $(git --version | awk '{print $3}')" || bad "git missing"
    local f; f="$(free_gb_of "$ARCHIVE")"
    [ "${f:-0}" -ge "$MIN_FREE_GB" ] && ok "disk: ${f}GB free (≥ ${MIN_FREE_GB})" || bad "disk low: ${f}GB < ${MIN_FREE_GB}"
    [ -n "$BACKUP_DIR" ] && { [ -d "$BACKUP_DIR" ] && ok "backup dir: $BACKUP_DIR" || warn "TAPE_BACKUP_DIR set but missing: $BACKUP_DIR"; } || warn "TAPE_BACKUP_DIR unset (durable backups skipped)"
    [ -f "$DB" ] && ok "DB present: $(db_count) conversations" || warn "no DB yet (run: tape update)"
    cd "$REPO" 2>/dev/null || return
    local origin; origin="$(git remote get-url origin 2>/dev/null || true)"
    if [ -z "$origin" ]; then
        bad "no 'origin' remote — run: tape init"
    elif is_public_upstream "$origin"; then
        warn "origin still points at the public lucys-tape repo — your archive should push to YOUR private repo (run: tape init)"
    else
        ok "origin: $(safe_url "$origin")"
        local why; why="$(check_destination)" && ok "push destination verified (tape.destination)" || bad "push destination: $why"
    fi
    git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1 && ok "upstream set: $(git rev-parse --abbrev-ref '@{u}')" || warn "no upstream branch (first push sets it)"
}

# ============================================================================
# Record origin's (single, rewritten) push URL as the trusted destination, after
# refusing the public upstream and, where GitHub can be asked, a public repo.
record_destination() {
    local urls n slug vis
    urls="$(git remote get-url --push --all origin 2>/dev/null)" || { bad "there is no 'origin' remote"; return 1; }
    n="$(printf '%s\n' "$urls" | grep -c .)"
    [ "$n" = "1" ] || { bad "origin pushes to ${n} places; it must push to exactly one"; return 1; }
    is_public_upstream "$urls" && { bad "origin is the PUBLIC lucys-tape repo"; return 1; }
    slug="$(github_slug "$urls")"
    [ "$slug" = "INVALID" ] && { bad "origin is a GitHub address without a plain owner/name"; return 1; }
    if [ -n "$slug" ]; then
        vis="$(github_visibility "$slug")"
        [ "$vis" = "PUBLIC" ] && { bad "GitHub reports $slug as PUBLIC — make it private first"; return 1; }
        [ -z "$vis" ] && warn "could not ask GitHub whether $slug is private (gh missing or signed out) — make sure it is"
    fi
    git config --local tape.destination "$urls" || { bad "could not record the destination"; return 1; }
    ok "trusted destination: $(safe_url "$urls")"
}

cmd_trust() {
    cd "$REPO" || die "cannot cd to $REPO"
    local urls; urls="$(git remote get-url --push --all origin 2>/dev/null)" || die "there is no 'origin' remote — add your PRIVATE repo: git remote add origin <url>"
    say "trust a destination for your archive"
    echo "  origin pushes to: $(safe_url "$urls")"
    echo "  Every nightly will push your conversations there. It must be a PRIVATE repo you own."
    [ -t 0 ] || die "tape trust needs you at the keyboard (it asks for confirmation)"
    printf "  Type 'private' to confirm: "
    local yn; read -r yn
    [ "$yn" = "private" ] || die "not confirmed — nothing recorded"
    record_destination || die "not recorded"
}

cmd_init() {
    say "${B}📼 Lucy's Tape — first-time setup${X}"
    echo "  Your AI wakes up every morning with no memory of yesterday."
    echo "  Let's make it the tape.  (Ctrl-C anytime; re-run: tape init)"
    echo
    # 0. preconditions
    [ -d "$HOME/.claude/projects" ] || die "~/.claude/projects not found — install/use Claude Code first, then come back"
    command -v python3 >/dev/null || die "python3 is required (stdlib only — no pip installs)"
    command -v git >/dev/null || die "git is required"

    # 1. detach from the public repo: your conversations must NEVER push there.
    cd "$REPO" || die "cannot cd to $REPO"
    local origin; origin="$(git remote get-url origin 2>/dev/null || true)"
    if is_public_upstream "$origin"; then
        say "step 1 — your PRIVATE archive repo"
        echo "  Your archive will be committed here and pushed to a repo YOU own."
        echo "  Create a PRIVATE empty repo first (e.g. on GitHub: 'my-tape', Private, no README)."
        printf "  Paste its git URL (or leave empty to stay local-only): "
        local url; read -r url
        git remote rename origin upstream || die "could not rename the public remote to 'upstream' — nothing changed"
        ok "public repo kept as 'upstream' (for tool updates)"
        if [ -n "$url" ]; then
            is_public_upstream "$url" && die "that is the PUBLIC lucys-tape repo — create a PRIVATE one of your own"
            git remote add origin "$url" || die "could not add origin $(safe_url "$url")"
            record_destination || die "origin was added but not trusted — fix it, then run: tape trust"
        else
            warn "local-only mode: no pushes until you set one (git remote add origin <url>)"
        fi
    else
        ok "origin already points at your own repo: $(safe_url "${origin:-(none — local-only)}")"
        if [ -n "$origin" ] && [ -z "$(trusted_dest)" ]; then cmd_trust || warn "not trusted yet — nightly pushes stay local until: tape trust"; fi
    fi

    # 2. put `tape` on the PATH
    say "step 2 — the 'tape' command"
    local bin="$HOME/.local/bin"
    mkdir -p "$bin"
    ln -sf "$SELF" "$bin/tape" && ok "linked: $bin/tape"
    case ":$PATH:" in
        *":$bin:"*) : ;;
        *) warn "$bin is not on your PATH — add:  export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
    esac

    # 3. first extraction
    say "step 3 — first extraction (read-only on sources, secret-scrubbed)"
    printf "  Run it now? [Y/n] "
    local yn; read -r yn
    if [ "${yn:-Y}" != "n" ] && [ "${yn:-Y}" != "N" ]; then
        cmd_update || warn "first update had warnings — check: tape logs"
    else
        warn "skipped — run later with: tape update"
    fi

    # 4. daily timer
    say "step 4 — the daily timer (this is what makes it a tape)"
    printf "  Install it now? [Y/n] "
    read -r yn
    if [ "${yn:-Y}" != "n" ] && [ "${yn:-Y}" != "N" ]; then
        cmd_install || true
    else
        warn "skipped — install later with: tape install"
    fi

    echo
    say "${G}done.${X} Browse your archive:  ${B}tape serve${X}  → http://127.0.0.1:${PORT}"
    say "Every day from now on, the tape rolls itself. 💜"
}

