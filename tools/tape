#!/usr/bin/env bash
# ╭──────────────────────────────────────────────────────────────────────────╮
# │  tape — control CLI for Lucy's Tape, your conversation archive           │
# │  init · update · build · serve · stop · install · uninstall · status     │
# │  · stats · backup · logs · doctor · help                                 │
# │  Linux/WSL (systemd timer) + macOS (launchd). Python tools run anywhere. │
# ╰──────────────────────────────────────────────────────────────────────────╯
set -uo pipefail
# Git must act on THIS repository and its own index: an inherited GIT_DIR,
# GIT_WORK_TREE or GIT_INDEX_FILE would point every command somewhere else.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
# Private by default (LT-SEC-006): everything this script and its Python tools create
# (archive, DB, logs, backups, temporary files) is readable by you alone.
umask 077

# ---- resolve paths -----------------------------------------------------------
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"
ARCHIVE="$REPO/archive"
DB="$ARCHIVE/conversations.db"
LOG="$ARCHIVE/refresh.log"
# The refresh lock lives in a directory only you can write (LT-SEC-011: a predictable
# name in the shared /tmp let another account block every refresh). $XDG_RUNTIME_DIR
# when it is yours and private, else ~/.cache/lucys-tape. The name carries this
# repo's identity, so two tape clones never block each other.
_repo_id="$(printf '%s' "$REPO" | cksum | cut -d' ' -f1)"
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -O "$XDG_RUNTIME_DIR" ] \
   && [ -z "$(find "$XDG_RUNTIME_DIR" -maxdepth 0 -perm -g+w 2>/dev/null)$(find "$XDG_RUNTIME_DIR" -maxdepth 0 -perm -o+w 2>/dev/null)" ]; then
    RUNDIR="$XDG_RUNTIME_DIR/lucys-tape"
else
    RUNDIR="$HOME/.cache/lucys-tape"
fi
LOCKDIR="$RUNDIR/refresh-${_repo_id}.lock.d"
VIEWER="$REPO/tools/conversations_viewer.py"
EXTRACT="$REPO/tools/extract_conversations.py"
BUILD="$REPO/tools/build_db.py"
UNIT_DIR="$HOME/.config/systemd/user"
LAUNCHD_DIR="$HOME/Library/LaunchAgents"
LAUNCHD_LABEL="com.lucys-tape.refresh"
PORT="${TAPE_PORT:-8124}"
OS="$(uname -s)"

# ---- tunables (override via env) --------------------------------------------
MIN_FREE_GB="${TAPE_MIN_FREE_GB:-2}"
KEEP_BACKUPS="${TAPE_KEEP_BACKUPS:-8}"
# Sanity floor: refuse to commit if the rebuilt archive holds fewer than this
# many conversations. Low by default (new users start near zero); the RATCHET
# below is the real protection once an archive has history.
SANITY_MIN="${TAPE_SANITY_MIN:-1}"
FORCE_DB_DAILY="${TAPE_FORCE_DB_DAILY:-0}"
BACKUP_DIR="${TAPE_BACKUP_DIR:-}"
LEAK_RX='sk-ant-[A-Za-z0-9]{15}|\bsk-[A-Za-z0-9]{20}|xai-[A-Za-z0-9]{20}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|[0-9]{8,}:[A-Za-z0-9_-]{35}|\b(MII[A-Za-z0-9+/]{3}IBAAK[BC]|MII[A-Za-z0-9+/]{3}IBADANBgkqhkiG9w0BAQEFAASC|MHcCAQEE|MIGkAgEBBD|MIHcAgEBBE|MIGHAgEAMBMGByqGSM49|MIG2AgEAMBAGByqGSM49|MIHuAgEAMBAGByqGSM49|MC4CAQAwBQYDK2V[uw]|MEcCAQAwBQYDK2Vx|MEYCAQAwBQYDK2Vv|b3BlbnNzaC1rZXktdjE)|\bsk-[a-z]{2,12}-[A-Za-z0-9_-]{20}'

# ---- the one place the archive may go (LT-SEC-004) ---------------------------
# Your conversations may only ever be pushed to, or released on, ONE destination:
# the private repo you named at `tape init` (or confirmed with `tape trust`),
# recorded in this clone's local git config as tape.destination. Every push and
# release checks the remote against it first and refuses on any mismatch.
PUBLIC_UPSTREAM_SLUG="michelabboud/lucys-tape"

# A URL printed with its credentials masked: user:password before the host (up to the
# LAST @, so a password holding an @ is covered) and token-like query values.
safe_url() { python3 -c '
import re, sys
u = sys.argv[1]
u = re.sub(r"(://)[^/?#]*@", r"\1***@", u)
u = re.sub(r"(?i)([?&][^=&#]*(token|key|secret|password|passwd|sig|auth)[^=&#]*=)[^&#]*", r"\1***", u)
print(u, end="")' "$1"; }
trusted_dest() { git config --local --get tape.destination 2>/dev/null; }
# owner/name (lower case) for a GitHub URL in any usual form (https, ssh with or
# without a port, scp-like; www./ssh. hosts; trailing / or .git). Prints INVALID for a
# GitHub URL whose path is not a plain owner/name, and nothing for other hosts.
github_slug() { python3 -c '
import re, sys
u = sys.argv[1].strip()
m = (re.match(r"(?i)^(?:https?|git|ssh)://(?:[^/@]*@)?((?:www\.|ssh\.)?github\.com)(?::\d+)?/(.*)$", u)
     or re.match(r"(?i)^(?:[^/@:]+@)?((?:www\.|ssh\.)?github\.com):(?!\d+/)(.*)$", u))
if not m:
    sys.exit(0)
path = re.sub(r"(?i)(\.git)?/*$", "", m.group(2).split("?")[0].split("#")[0])
parts = path.split("/")
ok = (len(parts) == 2 and all(re.fullmatch(r"[A-Za-z0-9._-]+", p) and p not in (".", "..") for p in parts))
print(path.lower() if ok else "INVALID", end="")' "$1"; }
is_public_upstream() { [ "$(github_slug "$1")" = "$PUBLIC_UPSTREAM_SLUG" ]; }
# PRIVATE / PUBLIC / INTERNAL as GitHub reports it, or empty when it cannot be asked
github_visibility() {
    command -v gh >/dev/null && gh auth status --hostname github.com >/dev/null 2>&1 || return 0
    # the host is named: GH_HOST must not send the question to another server
    gh repo view "github.com/$1" --json visibility --jq .visibility 2>/dev/null
}

# Is origin's push destination exactly the trusted one? Prints the reason when not.
check_destination() {
    local dest urls n slug vis
    dest="$(trusted_dest)"
    [ -n "$dest" ] || { echo "no trusted destination is recorded — run: tape trust"; return 1; }
    is_public_upstream "$dest" && { echo "the recorded destination is the PUBLIC lucys-tape repo — run: tape trust"; return 1; }
    # get-url applies insteadOf/pushInsteadOf rewrites: this is where a push really goes
    urls="$(git remote get-url --push --all origin 2>/dev/null)" || { echo "there is no 'origin' remote"; return 1; }
    n="$(printf '%s\n' "$urls" | grep -c .)"
    [ "$n" = "1" ] || { echo "origin pushes to ${n} places; it must push to exactly one"; return 1; }
    [ "$urls" = "$dest" ] || { echo "origin now pushes to $(safe_url "$urls"), not the trusted $(safe_url "$dest") — run: tape trust"; return 1; }
    slug="$(github_slug "$dest")"
    [ "$slug" = "INVALID" ] && { echo "the destination is a GitHub address without a plain owner/name — refusing"; return 1; }
    if [ -n "$slug" ]; then
        vis="$(github_visibility "$slug")"
        [ "$vis" = "PUBLIC" ] && { echo "GitHub reports $slug as PUBLIC — refusing"; return 1; }
    fi
    return 0
}

# ---- pretty output -----------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    B=$'\e[1m'; D=$'\e[2m'; R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; M=$'\e[35m'; X=$'\e[0m'
else
    B=''; D=''; R=''; G=''; Y=''; C=''; M=''; X=''
fi
say()  { echo "${C}📼${X} $*"; }
ok()   { echo "  ${G}✓${X} $*"; }
warn() { echo "  ${Y}!${X} $*"; }
bad()  { echo "  ${R}✗${X} $*"; }
log()  { echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*" >>"$LOG"; }
die()  { bad "$*"; log "FATAL: $*"; exit 1; }

# Portable free-GB (GNU df's --output is Linux-only; shutil works everywhere).
free_gb_of() { python3 -c 'import shutil,sys;print(shutil.disk_usage(sys.argv[1]).free // 2**30)' "$1" 2>/dev/null; }
db_count()   { python3 - "${1:-$DB}" <<'PY' 2>/dev/null
import sqlite3, sys
try: print(sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True).execute("SELECT COUNT(*) FROM conversations").fetchone()[0])
except Exception: print(0)
PY
}

# Portable single-instance lock: mkdir is atomic on every POSIX filesystem
# (flock does not exist on macOS). Stale locks (dead pid) are reclaimed.
# A process's start time, as a second identity check beside its PID: after a crash or
# reboot the lock's PID can belong to an unrelated live process (PIDs are reused), and
# the lock now lives somewhere that survives reboots. `ps -o lstart=` works on Linux
# and macOS.
proc_start() { ps -o lstart= -p "$1" 2>/dev/null | tr -s ' '; }
STALE_LOCK_MIN=360   # a lock with no readable owner is reclaimed after 6 hours

acquire_lock() {
    [ -L "$RUNDIR" ] && { bad "the lock directory $RUNDIR is a symlink — refusing to run"; return 2; }
    mkdir -p "$RUNDIR" 2>/dev/null
    if [ ! -d "$RUNDIR" ] || [ -L "$RUNDIR" ] || [ ! -O "$RUNDIR" ]; then
        bad "the lock directory $RUNDIR is not a directory you own — refusing to run"; return 2
    fi
    chmod 700 "$RUNDIR" 2>/dev/null
    if [ -e "$LOCKDIR" ] || [ -L "$LOCKDIR" ]; then
        if [ -L "$LOCKDIR" ] || [ ! -O "$LOCKDIR" ]; then
            bad "the refresh lock $LOCKDIR belongs to someone else — refusing to run"; return 2
        fi
    fi
    if mkdir "$LOCKDIR" 2>/dev/null; then
        printf '%s %s\n' "$$" "$(proc_start $$)" >"$LOCKDIR/owner"
        trap 'rm -rf "$LOCKDIR"; [ -n "${TMP_INDEX:-}" ] && rm -f "$TMP_INDEX"' EXIT
        return 0
    fi
    # Held. It is live only if its PID still runs AND started when the lock says.
    local owner pid started stale=0
    owner="$(cat "$LOCKDIR/owner" 2>/dev/null)"
    pid="${owner%% *}"; started="${owner#* }"
    if [ -z "$owner" ] || [ "$pid" = "$owner" ]; then
        # no readable owner (killed between mkdir and write): stale once old enough
        [ -n "$(find "$LOCKDIR" -maxdepth 0 -mmin +"$STALE_LOCK_MIN" 2>/dev/null)" ] && stale=1
    elif ! kill -0 "$pid" 2>/dev/null || [ "$(proc_start "$pid")" != "$started" ]; then
        stale=1
    fi
    if [ "$stale" -eq 1 ]; then
        # rename first: only one of two racing runs can claim a stale lock
        local grave="$LOCKDIR.stale.$$"
        if mv "$LOCKDIR" "$grave" 2>/dev/null; then
            log "reclaimed a stale refresh lock (owner: ${owner:-unknown})"
            rm -rf "$grave"
            acquire_lock; return $?
        fi
    fi
    log "refresh lock busy (owner: ${owner:-unknown}) — this run exits"
    return 1
}

# Leak guard, masking edition. The redactor is the primary filter; this is the
# last-line net for anything it missed. Instead of ABORTING the whole refresh (a
# stuck pipeline protects nobody, and the unmasked secret sits in the tree anyway),
# we MASK every residual LEAK_RX hit in place — over-redaction beats any leak — and
# let the commit proceed. Each affected file + hit-count is logged (never the value),
# so the redactor can still be hardened at source. Prints "<files> <hits>".
mask_leaks() { python3 - "$ARCHIVE" "$LEAK_RX" "$LOG" "$REPO/tools" <<'PY'
import os, re, sys
root, rx_src, logpath = sys.argv[1], sys.argv[2], sys.argv[3]
sys.path.insert(0, sys.argv[4])
import safe_paths  # read and rewrite without following links (LT-SEC-009)
rx = re.compile(rx_src, re.ASCII)  # same \b as grep in the C locale and the redactor
# A mask covers the whole token, not just the part the guard's pattern names: the
# guard matches e.g. the first 20 characters of a key, and the rest must go too.
mask_rx = re.compile(f"(?:{rx_src})[A-Za-z0-9_+/=-]*", re.ASCII)
MARK = "[****REDACTED-BY-GUARD****]"  # asterisked; matches no LEAK_RX (idempotent); greppable for audit
files = hits = 0


def shown(p):
    rel = os.path.relpath(p, root)
    return "(a file whose name matches the leak guard; name withheld)" if rx.search(rel) else rel


with open(logpath, "a", encoding="utf-8") as lg:
    for dp, _, fns in os.walk(root):
        for fn in fns:
            if not (fn.endswith(".md") or fn == "REDACTION-REPORT.txt"):
                continue
            p = os.path.join(dp, fn)
            try:
                fh, _ = safe_paths.open_source(p, root, follow_links=False)
                with fh:
                    txt = fh.read().decode("utf-8")
            except safe_paths.Refused as e:
                # never rewritten; the commit gate refuses links and non-regular files too
                lg.write(f"  guard-mask: WARN skipped {shown(p)}: {e.strerror}\n")
                continue
            except Exception as e:
                lg.write(f"  guard-mask: WARN unreadable {shown(p)}: {type(e).__name__}\n")
                continue
            new, n = mask_rx.subn(MARK, txt)
            if n:
                safe_paths.write_text(p, new, root)
                files += 1; hits += n
                lg.write(f"  guard-mask: masked {n} residual secret(s) in {shown(p)}\n")
print(f"{files} {hits}")
PY
}

# Archive commit gate (LT-SEC-003). Run with GIT_INDEX_FILE pointing at a PRIVATE
# index that holds HEAD plus `git add -A -- archive/`. Only our own output may be
# committed: archive/INDEX.md, archive/REDACTION-REPORT.txt, archive/conversations/**.md.
# Anything else under archive/ is put back to HEAD in the private index and reported
# (a stray file never blocks the nightly). What remains is checked: no gitlinks, no
# path matching LEAK_RX, and every blob (the exact bytes git will commit, fetched by
# object id and streamed) scanned with LEAK_RX. Prints "<problems> <skipped> <changes>";
# details go to the log with any matching name withheld.
archive_gate() { python3 - "$LEAK_RX" "$LOG" <<'PY'
import os, re, subprocess, sys
rx, logpath = re.compile(sys.argv[1], re.ASCII), sys.argv[2]
ALLOWED = re.compile(r"archive/(INDEX\.md|REDACTION-REPORT\.txt|conversations/[^\n\r]+\.md)")
enc = lambda b: b.decode("utf-8", "surrogateescape")


def raw_diff():
    out = subprocess.run(["git", "diff", "--cached", "--raw", "-z", "--no-renames", "--no-abbrev"],
                         check=True, capture_output=True).stdout
    parts, entries = out.split(b"\0"), []
    for i in range(0, len(parts) - 1, 2):
        meta, path = parts[i].split(), enc(parts[i + 1])
        entries.append((meta[1].decode(), meta[3].decode(), meta[4].decode(), path))
    return entries  # (new mode, new object id, status, path)


def label(n, path):
    return f"#{n} (name matches the leak guard; withheld)" if rx.search(path) else path


log, problems = [], 0
REGULAR = ("100644", "100755")
# Not archive output: a name outside the allow-list, or a symlink / gitlink / other
# non-file under an allowed name. Deletions of such entries are strays too.
stray = [e for e in raw_diff()
         if not ALLOWED.fullmatch(e[3]) or (e[2] != "D" and e[0] not in REGULAR)]
if stray:
    # GIT_LITERAL_PATHSPECS: a stray file named `archive/*` must not act as a wildcard
    subprocess.run(["git", "reset", "-q", "--pathspec-from-file=-", "--pathspec-file-nul"],
                   input=b"".join(e[3].encode("utf-8", "surrogateescape") + b"\0" for e in stray),
                   env={**os.environ, "GIT_LITERAL_PATHSPECS": "1"}, check=True)
    for n, e in enumerate(stray, 1):
        log.append(f"skipped (not archive output, left uncommitted): {label(n, e[3])}")
entries = raw_diff()
if any(not ALLOWED.fullmatch(e[3]) or (e[2] != "D" and e[0] not in REGULAR) for e in entries):
    log.append("a stray path could not be unstaged")
    problems += 1
blobs = []
for n, (mode, oid, status, path) in enumerate(entries, 1):
    if rx.search(path):
        log.append(f"staged path {label(n, path)} matches the leak guard")
        problems += 1
    if status == "D":
        continue
    if mode not in REGULAR:
        log.append(f"staged entry {label(n, path)} is not a regular file (mode {mode})")
        problems += 1
        continue
    blobs.append((n, oid, path))
if blobs:
    cat = subprocess.Popen(["git", "cat-file", "--batch"], stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    for n, oid, path in blobs:  # one request, one answer: memory stays at one blob
        cat.stdin.write(oid.encode() + b"\n")
        cat.stdin.flush()
        header = cat.stdout.readline().split()
        if len(header) != 3 or header[0].decode() != oid or header[1] != b"blob":
            log.append(f"could not read staged blob for {label(n, path)}")
            problems += 1
            break
        data = cat.stdout.read(int(header[2]))
        cat.stdout.read(1)
        if rx.search(data.decode("utf-8", "replace")):
            log.append(f"staged content of {label(n, path)} matches the leak guard")
            problems += 1
    cat.stdin.close()
    if cat.wait() != 0:
        log.append("git cat-file failed")
        problems += 1
with open(logpath, "a", encoding="utf-8") as lg:
    for line in log:
        lg.write(f"  archive-gate: {line}\n")
print(problems, len(stray), len(entries))
PY
}

