# Lucy's Tape reads these from the environment. None is required; the defaults work.
# This file documents them. Never put a secret here.

# --- install.sh ---
# Where the installer clones the tape. Optional.
LUCYS_TAPE_DIR=$HOME/lucys-tape
# Which repository the installer clones. Optional.
LUCYS_TAPE_REPO=https://github.com/michelabboud/lucys-tape.git

# --- tools/tape ---
# Port for `tape serve` (the local viewer, loopback only). Optional.
TAPE_PORT=8124
# Refuse to run the nightly update when the disk has less free space than this, in GB. Optional.
TAPE_MIN_FREE_GB=2
# How many database backups `tape backup` keeps. Optional.
TAPE_KEEP_BACKUPS=8
# Refuse to commit if the rebuilt archive holds fewer conversations than this. Optional.
TAPE_SANITY_MIN=1
# 1 = run the weekly durable backup and database release snapshot on every update, not only Sundays. Optional.
TAPE_FORCE_DB_DAILY=0
# Where durable backups go (a second disk or a synced folder). Empty = backups are skipped. Optional.
TAPE_BACKUP_DIR=
# Any value turns off coloured output. Optional.
NO_COLOR=
